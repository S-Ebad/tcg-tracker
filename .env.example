# Copy to .env and adjust. .env is git-ignored.
DATABASE_URL=postgresql://tcg:tcg@localhost:5432/tcg
# Database for tests/test_db.py and scripts/bench_load.py. Its name must end in _test: its schema is wiped.
TEST_DATABASE_URL=postgresql://tcg:tcg@localhost:5432/tcg_test
# Contact address put in the scraper's User-Agent (required to crawl)
TCG_CONTACT_EMAIL=you@example.com
# Alerts (tcg_tracker/monitoring.py). Leave empty to only log them and store them in scrape_runs.alerts.
ALERT_DISCORD_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
# Scheduled jobs (scripts/scheduled.py)
# BACKUP_DIR defaults to %OneDrive%\tcg-tracker-backups (or ~/tcg-tracker-backups without OneDrive)
BACKUP_DIR=
BACKUP_KEEP=14
FRESHNESS_MAX_HOURS=26
# Only for scripts/localdb.ps1 (local Postgres without Docker)
POSTGRES_SUPERUSER_PASSWORD=change-me
