# Copy to .env and adjust. .env is git-ignored.
DATABASE_URL=postgresql://tcg:tcg@localhost:5432/tcg
# Database for tests/test_db.py and scripts/bench_load.py. Its name must end in _test: its schema is wiped.
TEST_DATABASE_URL=postgresql://tcg:tcg@localhost:5432/tcg_test
# Contact address put in the scraper's User-Agent (required to crawl)
TCG_CONTACT_EMAIL=you@example.com
# Only for scripts/localdb.ps1 (local Postgres without Docker)
POSTGRES_SUPERUSER_PASSWORD=change-me
